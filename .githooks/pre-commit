#!/bin/bash

# Get all files changed (added, modified, copied, etc., excluding deleted) from origin/main to current state
while IFS= read -r -d '' filepath; do
  # Skip if file doesn't exist
  if [[ ! -f "$filepath" ]]; then
    continue
  fi

  # Skip if the file is not a text file to prevent accidentally modifying binaries
  if ! file "$filepath" | grep -q "text"; then
    continue
  fi

  # Remove trailing empty spaces and tabs for each line
  sed -i 's/[ \t]*$//' "$filepath"

  # If it's a Python file, run Python-specific formatters and linters
  if [[ "$filepath" == *.py ]]; then
    autopep8 -i --aggressive --aggressive "$(pwd)/$filepath"
    ruff check --fix "$(pwd)/$filepath"
    ruff format "$(pwd)/$filepath"
  fi

  # Re-stage the file with the stripped trailing spaces (and formatting)
  git add "$(pwd)/$filepath"
done < <(git diff -z --name-only --diff-filter=d origin/main)
