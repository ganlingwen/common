[user]
  email = ganlingwen@gmail.com
  name = ganlingwen

[core]
  editor = vim

[alias]
  amend = commit --amend
  co = checkout
  br = branch
  fpush = push --force-with-lease
  st = status
  sl = log --graph --pretty=format:'commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset' --all
  clear = remote prune origin